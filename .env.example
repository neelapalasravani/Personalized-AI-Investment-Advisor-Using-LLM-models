# -----------------------------------------------------------------------
# Required — API credentials
# Copy this file to .env and fill in real values (never commit .env)
# -----------------------------------------------------------------------

# Together AI API key (https://api.together.xyz/)
TOGETHER_API_KEY=your_together_api_key_here

# Tavily Search API key (https://app.tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# -----------------------------------------------------------------------
# Optional — application configuration (defaults shown)
# -----------------------------------------------------------------------

# Path to the ETF CSV dataset
ETF_DATA_PATH=data/etf_dataset_sample.csv

# SQLite database file path
ETF_DB_FILE=etf_database.db

# Gradio server bind address
APP_HOST=0.0.0.0

# Gradio server port
APP_PORT=7860

# Set to 'true' to create a public Gradio share link
APP_SHARE=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
